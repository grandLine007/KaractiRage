{
  "$defs": {
    "EntityPatch": {
      "description": "Patch partiel et typé d'une entité : seuls les champs modifiés sont présents.",
      "properties": {
        "color": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "h": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "health": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialPatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "mesh_asset": {
          "description": "Asset de maillage 3D (`MeshRef::Asset`).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "rotation": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "speed": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "sprite_asset": {
          "description": "Asset de sprite pixel-art (`ShapeKind::ImageRef`).",
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "w": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "x": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MaterialPatch": {
      "description": "Patch partiel d'un matériau 3D.",
      "properties": {
        "asset": {
          "description": "Bascule vers un matériau asset nommé.",
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metalness": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "roughness": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PropertyValue": {
      "description": "Valeur typée d'une propriété (édition d'un champ quelconque).",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "int",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "float",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "string",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Teinte `0x00RRGGBB`.",
          "properties": {
            "type": {
              "const": "color",
              "type": "string"
            },
            "value": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "TargetRef": {
      "description": "Référence à une cible, telle que fournie par le Studio ou proposée par le LLM.\n\nReprésentation JSON externe (compacte, adaptée au prompt) : `\"selected\"`,\n`{\"entity_id\": 42}`, `{\"kvl_node_id\": \"evt\"}`, `{\"area\": {\"x\": 0.0, …}}`.",
      "oneOf": [
        {
          "const": "selected",
          "description": "L'élément actuellement sélectionné (résolu via `EditContext::selection`).",
          "type": "string"
        },
        {
          "const": "hovered",
          "description": "L'élément survolé (résolu via `EditContext::hover`).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Identifiant stable d'entité.",
          "properties": {
            "entity_id": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "entity_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nom d'entité (doit être unique, sinon la cible est ambiguë).",
          "properties": {
            "entity_name": {
              "type": "string"
            }
          },
          "required": [
            "entity_name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nœud d'un graphe KVL.",
          "properties": {
            "kvl_node_id": {
              "type": "string"
            }
          },
          "required": [
            "kvl_node_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Position monde sous le curseur (pour « ici »).",
          "properties": {
            "cursor": {
              "properties": {
                "x": {
                  "format": "float",
                  "type": "number"
                },
                "y": {
                  "format": "float",
                  "type": "number"
                },
                "z": {
                  "format": "float",
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "x",
                "y"
              ],
              "type": "object"
            }
          },
          "required": [
            "cursor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Zone rectangulaire monde (sélection multiple).",
          "properties": {
            "area": {
              "properties": {
                "h": {
                  "format": "float",
                  "type": "number"
                },
                "w": {
                  "format": "float",
                  "type": "number"
                },
                "x": {
                  "format": "float",
                  "type": "number"
                },
                "y": {
                  "format": "float",
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "type": "object"
            }
          },
          "required": [
            "area"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Toutes les entités portant ce tag.",
          "properties": {
            "tag": {
              "type": "string"
            }
          },
          "required": [
            "tag"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Toutes les entités de ce type (`kind` ≈ `tag` dans le modèle actuel).",
          "properties": {
            "all_of_kind": {
              "type": "string"
            }
          },
          "required": [
            "all_of_kind"
          ],
          "type": "object"
        }
      ]
    },
    "UiElement": {
      "description": "Élément d'un écran UI (texte, barre, bouton, icône).",
      "properties": {
        "bind": {
          "default": null,
          "description": "Variable liée (\"player_hp\", \"score\", \"objective\").",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "\"text\", \"bar\", \"button\", \"icon\".",
          "type": "string"
        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Opération atomique appliquée sur un clone du projet.\n\nLes ops de **création** (`AddEntity`, `CreateScene`, …) construisent un niveau ; les ops\nde **mutation** (`UpdateEntity`, `DeleteEntity`, `SetTransform2D`, …) éditent un élément\nexistant et portent une [`TargetRef`]. Une cible contextuelle (`Selected`, `Hovered`)\ndoit être liée à des identifiants concrets avant exécution (voir `ai_edit::bind_ops`).",
  "oneOf": [
    {
      "properties": {
        "genre": {
          "type": "string"
        },
        "op": {
          "const": "create_project",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "title",
        "genre"
      ],
      "type": "object"
    },
    {
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "const": "create_scene",
          "type": "string"
        }
      },
      "required": [
        "op",
        "name"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "op": {
          "const": "add_entity",
          "type": "string"
        }
      },
      "required": [
        "op",
        "name",
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "component": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "op": {
          "const": "set_entity_component",
          "type": "string"
        }
      },
      "required": [
        "op",
        "entity",
        "component"
      ],
      "type": "object"
    },
    {
      "properties": {
        "node_id": {
          "type": "string"
        },
        "node_type": {
          "type": "string"
        },
        "op": {
          "const": "add_kvl_node",
          "type": "string"
        }
      },
      "required": [
        "op",
        "node_id",
        "node_type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "from": {
          "type": "string"
        },
        "from_pin": {
          "type": "string"
        },
        "op": {
          "const": "connect_pins",
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "to_pin": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "from",
        "from_pin",
        "to",
        "to_pin"
      ],
      "type": "object"
    },
    {
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "const": "set_variable",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "name",
        "value"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "set_objective",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "text"
      ],
      "type": "object"
    },
    {
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "const": "add_level",
          "type": "string"
        }
      },
      "required": [
        "op",
        "name"
      ],
      "type": "object"
    },
    {
      "properties": {
        "asset": {
          "type": "string"
        },
        "op": {
          "const": "add_mesh",
          "type": "string"
        }
      },
      "required": [
        "op",
        "asset"
      ],
      "type": "object"
    },
    {
      "properties": {
        "entity": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "op": {
          "const": "set_material",
          "type": "string"
        }
      },
      "required": [
        "op",
        "entity",
        "material"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "set_camera",
          "type": "string"
        },
        "position": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "op",
        "position"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "type": "string"
        },
        "op": {
          "const": "add_light",
          "type": "string"
        }
      },
      "required": [
        "op",
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "archetype": {
          "type": "string"
        },
        "op": {
          "const": "generate_sprite",
          "type": "string"
        }
      },
      "required": [
        "op",
        "archetype"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "set_audio",
          "type": "string"
        },
        "sound": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "sound"
      ],
      "type": "object"
    },
    {
      "properties": {
        "elements": {
          "default": [],
          "description": "Éléments déclaratifs (texte, jauge, bouton, icône), optionnels.",
          "items": {
            "$ref": "#/$defs/UiElement"
          },
          "type": "array"
        },
        "op": {
          "const": "set_ui_screen",
          "type": "string"
        },
        "screen": {
          "description": "Type d'écran : \"hud\", \"menu\", \"pause\", \"game_over\", \"victory\".",
          "type": "string"
        },
        "title": {
          "description": "Titre affiché (écrans plein écran), optionnel.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "op",
        "screen"
      ],
      "type": "object"
    },
    {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "op": {
          "const": "set_save_config",
          "type": "string"
        }
      },
      "required": [
        "op",
        "enabled"
      ],
      "type": "object"
    },
    {
      "properties": {
        "format": {
          "type": "string"
        },
        "op": {
          "const": "export_target",
          "type": "string"
        }
      },
      "required": [
        "op",
        "format"
      ],
      "type": "object"
    },
    {
      "description": "Applique un patch partiel typé à la cible (`name`, `tag`, `color`, transform, vitesse…).",
      "properties": {
        "op": {
          "const": "update_entity",
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/EntityPatch"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "op",
        "target",
        "patch"
      ],
      "type": "object"
    },
    {
      "description": "Supprime les entités ciblées (risque destructif).",
      "properties": {
        "op": {
          "const": "delete_entity",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TargetRef"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "targets"
      ],
      "type": "object"
    },
    {
      "description": "Duplique les entités ciblées avec un décalage monde `(dx, dy)`.",
      "properties": {
        "offset": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "op": {
          "const": "duplicate_entity",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TargetRef"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "targets",
        "offset"
      ],
      "type": "object"
    },
    {
      "description": "Pose un transform 2D complet.",
      "properties": {
        "h": {
          "format": "float",
          "type": "number"
        },
        "op": {
          "const": "set_transform_2d",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "w": {
          "format": "float",
          "type": "number"
        },
        "x": {
          "format": "float",
          "type": "number"
        },
        "y": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "op",
        "target",
        "x",
        "y",
        "w",
        "h"
      ],
      "type": "object"
    },
    {
      "description": "Pose un transform 3D complet (rotation Euler en degrés).",
      "properties": {
        "op": {
          "const": "set_transform_3d",
          "type": "string"
        },
        "position": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rotation_euler_deg": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "scale": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "op",
        "target",
        "position",
        "rotation_euler_deg",
        "scale"
      ],
      "type": "object"
    },
    {
      "description": "Écrit une propriété par chemin (`transform.x`, `renderable.color`, `speed`…).",
      "properties": {
        "op": {
          "const": "set_entity_property",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "value": {
          "$ref": "#/$defs/PropertyValue"
        }
      },
      "required": [
        "op",
        "target",
        "path",
        "value"
      ],
      "type": "object"
    },
    {
      "description": "Ajoute un composant (`collider`, `movement`, `health`, `vision`, `transform3d`…).",
      "properties": {
        "component": {
          "type": "string"
        },
        "op": {
          "const": "add_component",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "op",
        "target",
        "component"
      ],
      "type": "object"
    },
    {
      "description": "Retire un composant (risque destructif).",
      "properties": {
        "component": {
          "type": "string"
        },
        "op": {
          "const": "remove_component",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "op",
        "target",
        "component"
      ],
      "type": "object"
    },
    {
      "description": "Règle un paramètre de nœud KVL (`position_x`, `name`, `input.<pin>`…).",
      "properties": {
        "op": {
          "const": "set_kvl_node_param",
          "type": "string"
        },
        "param": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "value": {
          "$ref": "#/$defs/PropertyValue"
        }
      },
      "required": [
        "op",
        "target",
        "param",
        "value"
      ],
      "type": "object"
    },
    {
      "description": "Supprime un nœud KVL et ses connexions (risque destructif).",
      "properties": {
        "op": {
          "const": "delete_kvl_node",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "op",
        "target"
      ],
      "type": "object"
    },
    {
      "description": "Supprime une connexion par identifiant (`graph` vide = recherche globale).",
      "properties": {
        "graph": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "op": {
          "const": "remove_connection",
          "type": "string"
        }
      },
      "required": [
        "op",
        "id"
      ],
      "type": "object"
    },
    {
      "description": "Règle un réglage de scène (`name`, `description`, `objective`).",
      "properties": {
        "key": {
          "type": "string"
        },
        "op": {
          "const": "set_scene_setting",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/PropertyValue"
        }
      },
      "required": [
        "op",
        "key",
        "value"
      ],
      "type": "object"
    },
    {
      "description": "Applique plusieurs ops en une seule intention (tout ou rien).",
      "properties": {
        "op": {
          "const": "batch",
          "type": "string"
        },
        "ops": {
          "items": {
            "$ref": "#"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "ops"
      ],
      "type": "object"
    }
  ],
  "title": "AiOp"
}
